def icmd():
    try:
        cmd=tool.getInput(False,"> ").strip()
        if not cmd:
            return
        if cmd=="exit":
            return "exit"
        elif cmd=="help":
            for c in cmds:
                print(c)
        elif cmd=="mdir":
            tool.mdir()
        elif cmd=="read":
            tool.read(tool.getInput(False,"File: "))
        elif cmd=="write":
            tool.write(tool.getInput(False,"File: "))
        elif cmd=="append":
            tool.appendFile()
        elif cmd=="sfile":
            tool.sfile(
                tool.getInput(False,"File: "),
                tool.getInput(False,"Search: ")
            )
        elif cmd=="mkpasswd":
            tool.mkpasswd()
        elif cmd=="guess":
            tool.guess()
        elif cmd=="calc":
            tool.calc()
        elif cmd=="local":
            tool.local()
        elif cmd=="osi":
            try:
                tool.osi()
            except AttributeError:
                print("OSI module/function unavailable.")
        elif cmd=="ohd":
            tool.ohd()
        elif cmd=="wdh":
            tool.wdh()
        elif cmd=="pchk":
            tool.pchk()
        elif cmd=="lsys":
            tool.lsys()
        elif cmd=="dirmap":
            tool.dirmap()
        elif cmd=="sila":
            try:
                target=tool.getInput(False,"Target: ")
                out=tool.getInput(False,"Output file: ")
                if not target or not out:
                    return
                tool.cmd(
                    [
                        "python",
                        "sila.py",
                        target,
                        "--json",
                        out
                    ]
                )
            except Exception as e:
                print(f"SILA error: {e}")
        elif cmd=="strcalc":
            tool.strcalc()
        elif cmd=="cls":
            tool.cls()
        elif cmd=="cmd":
            command=tool.getInput(False,"CMD: ")
            if command:
                tool.cmd(command)
        else:
            print("Unknown command. Type 'help' for options.")
    except KeyboardInterrupt:
        print("\nCommand cancelled.")
    except Exception as e:
        print(f"Command error: {e}")
try:
