class SafeCalc:
    OPS={
        ast.Add:operator.add,
        ast.Sub:operator.sub,
        ast.Mult:operator.mul,
        ast.Div:operator.truediv,
        ast.Mod:operator.mod,
        ast.Pow:operator.pow,
        ast.FloorDiv:operator.floordiv,
        ast.USub:operator.neg,
        ast.UAdd:operator.pos,
    }
    @staticmethod
    def eval_expr(expr):
        if not isinstance(expr,str):
            raise TypeError("Expression must be text")
        node=ast.parse(expr,mode="eval").body
        return SafeCalc._eval(node)
    @staticmethod
    def _eval(node):
        if isinstance(node,ast.BinOp):
            operation=SafeCalc.OPS.get(type(node.op))
            if operation is None:
                raise ValueError("Unsupported operator")
            return operation(
                SafeCalc._eval(node.left),
                SafeCalc._eval(node.right)
            )
        elif isinstance(node,ast.UnaryOp):
            operation=SafeCalc.OPS.get(type(node.op))
            if operation is None:
                raise ValueError("Unsupported operator")
            return operation(
                SafeCalc._eval(node.operand)
            )
        elif isinstance(node,ast.Constant):
            if isinstance(node.value,(int,float)):
                return node.value
            raise ValueError("Only numbers allowed")
        else:
            raise TypeError(
                f"Unsupported expression: {ast.dump(node)}"
            )
class tool:
    @staticmethod
    def getInput(ios,arg):
        try:
            val=input(arg)
            return int(val) if ios else val
        except ValueError:
            print("Invalid input.")
            return 0 if ios else ""
        except KeyboardInterrupt:
            print("\nCancelled.")
            return 0 if ios else ""
        except Exception as e:
            print(f"Input error: {e}")
            return 0 if ios else ""
    @staticmethod
    def cmd(args,capture=False):
        try:
            args=safe_split(args)
            if not args:
                return None
            result=subprocess.run(
                args,
                capture_output=capture,
                text=True,
                shell=False,
                timeout=COMMAND_TIMEOUT
            )
            if capture:
                return result.stdout
            return None
        except subprocess.TimeoutExpired:
            print("[ERROR] Command timed out.")
        except FileNotFoundError:
            print("[ERROR] Command not found.")
        except subprocess.SubprocessError as e:
            print(f"[ERROR] Command failed: {e}")
        except Exception as e:
            print(f"[ERROR] Unexpected command error: {e}")
        return None
